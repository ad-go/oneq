[Unit]
Description=oneqrelay: federated registry + relay for the oneq mesh (behind a PQ-only TLS reverse proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oneqrelay
Group=oneqrelay
StateDirectory=oneqrelay
# /etc/oneq/relay.env : ONEQRELAY_ARGS="--id r1 --listen 127.0.0.1:8080 --insecure-http --trust-proxy --fed-peer https://r2.example.org --cafile /etc/ssl/certs/ca-certificates.crt"
# /etc/oneq/federation.secret : shared by every oneqrelay of the federation (mode 0600, from `oneqrelay.py gen-secret`)
EnvironmentFile=/etc/oneq/relay.env
LoadCredential=secret:/etc/oneq/federation.secret
ExecStart=/opt/oneq-src/venv/bin/python /opt/oneq-src/oneqrelay.py run --db ${STATE_DIRECTORY}/registry.db --secret-file %d/secret $ONEQRELAY_ARGS
Restart=on-failure
RestartSec=3

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
