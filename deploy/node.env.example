# /etc/oneq-p2p/NAME.env  (chmod 600). Loaded by oneq-p2p@NAME.service.
# Node behind the internet:
ONEQ_P2P_ARGS="--peer /etc/oneq-p2p/peer-NAME.pub --ifname pq0 --addr 10.99.0.1/24 --listen 0.0.0.0:51820 --advertise 203.0.113.5:51820 --rendezvous https://rv.example.org"

# Bound to the address of an existing interface (it stays owned by the process that created it; the tunnel uses its OWN TUN, MTU 1220):
# ONEQ_P2P_ARGS="--peer /etc/oneq-p2p/peer-NAME.pub --ifname pq0 --addr 10.99.0.1/24 --via IFACE --listen 0.0.0.0:51820 --rendezvous https://rv.example.org"
