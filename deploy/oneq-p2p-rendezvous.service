[Unit]
Description=oneqtunel rendezvous + relay server (behind a PQ-only TLS reverse proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oneq-p2p-rv
Group=oneq-p2p-rv
# /etc/oneq-p2p/tokens.sha256: one SHA-256(token) per line (python3 rendezvous_server.py hash-token)
ExecStart=/opt/oneq-src/venv/bin/python /opt/oneq-src/rendezvous_server.py run --listen 127.0.0.1:8080 --insecure-http --trust-proxy --tokens-file /etc/oneq-p2p/tokens.sha256
Restart=on-failure
RestartSec=3

# Least privilege: no capabilities, read-only system, private /tmp
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
