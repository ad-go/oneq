# Alternative to nginx. NOT TESTED in this project (caddy was not available on the test host).
# Needs Caddy >= 2.10 (Go >= 1.24, X25519MLKEM768 support). Let's Encrypt is automatic.
# Start rendezvous_server.py with:  run --listen 127.0.0.1:8080 --insecure-http --trust-proxy ...
rv.example.org {
	tls {
		protocols tls1.3 tls1.3
		curves x25519mlkem768
	}
	request_body {
		max_size 16KB
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
