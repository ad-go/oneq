[Unit]
Description=oneq gateway: NAT for a private network behind this node (test bench)
After=network-online.target oneqnode@mesh.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/oneq-gateway start
ExecStop=/usr/local/sbin/oneq-gateway stop

[Install]
WantedBy=multi-user.target
