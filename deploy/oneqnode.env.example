# /etc/oneq/NAME.env  (chmod 600). NAME is also the TAP interface name (oneq-style: oneqnode@oneq0).
# Several oneqrelays for failover: repeat --relay. Address and MAC are allocated automatically by the oneqrelay.
ONEQNODE_ARGS="--relay https://r1.example.org --relay https://r2.example.org --community lan --user alice --name laptop --listen 0.0.0.0:51820 --advertise 203.0.113.5:51820"

# Bound to the address of an existing interface (it stays owned by the process that created it; oneqnode uses its own TAP):
# ONEQNODE_ARGS="--relay https://r1.example.org --community lan --user alice --via IFACE --listen 0.0.0.0:51820"
