[Unit]
Description=oneqtunel VPN node %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oneq-p2p
Group=oneq-p2p
# /etc/oneq-p2p/%i.env   : ONEQ_P2P_ARGS="--peer /etc/oneq-p2p/peer-%i.pub --addr 10.99.0.1/24 --rendezvous https://rv.example.org --advertise 203.0.113.5:51820 ..."
# /etc/oneq-p2p/%i.key   : private key (mode 0600, root)         -> exposed to the service as %d/key
# /etc/oneq-p2p/%i.token : network token (mode 0600, root)       -> exposed to the service as %d/token
# Neither the key nor the token ever appears on the command line.
EnvironmentFile=/etc/oneq-p2p/%i.env
LoadCredential=key:/etc/oneq-p2p/%i.key
LoadCredential=token:/etc/oneq-p2p/%i.token
ExecStart=/opt/oneq-src/venv/bin/python /opt/oneq-src/oneqtunel.py run --key %d/key --token-file %d/token $ONEQ_P2P_ARGS
Restart=on-failure
RestartSec=3

# CAP_NET_ADMIN only for this unit: create/configure the TUN device (ip addr / ip link)
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
