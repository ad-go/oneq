# OpenSSL config loaded ONLY by oneqtunel / rendezvous_server (pqtls.py sets OPENSSL_CONF).
# Forces TLS 1.3 and a single key-exchange group: hybrid X25519 + ML-KEM-768.
# A peer that does not offer X25519MLKEM768 gets a handshake_failure; there is no fallback.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.3
MaxProtocol = TLSv1.3
Groups = X25519MLKEM768
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
