#!/bin/sh
# Administer the local registry: communities, users, nodes. Runs as the oneqrelay user so the database stays owned by
# it; db, id and secret come from /etc/oneq/relay.conf. Accounts and nodes replicate to the other relays.
#   oneqrelay-admin community-add lan 10.50.0.0/24
#   oneqrelay-admin user-add lan alice --role admin   (asks for the password; scripts: $TUNMESH_PASSWORD, or
#                                                      --password-file F readable by the oneqrelay user)
#   oneqrelay-admin list
set -e
if [ "$(id -u)" != 0 ]; then
    echo "oneqrelay-admin: run as root (sudo oneqrelay-admin ...)" >&2
    exit 1
fi
exec /usr/sbin/runuser -u oneqrelay -- /opt/oneq/relay/bin/oneqrelay admin --config /etc/oneq/relay.conf "$@"
