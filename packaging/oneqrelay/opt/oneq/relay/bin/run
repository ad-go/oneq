#!/bin/sh
# Starts the oneqrelay server from /etc/oneq/relay.conf. Used by oneqrelay.service (systemd) and by the supervisord
# program, so both start it exactly the same way. When started as root (supervisord) it drops to the unprivileged
# oneqrelay user first.
set -e
if [ "$(id -u)" = 0 ]; then
    exec /usr/bin/setpriv --reuid=oneqrelay --regid=oneqrelay --clear-groups --no-new-privs \
        /opt/oneq/relay/bin/oneqrelay run --config /etc/oneq/relay.conf
fi
exec /opt/oneq/relay/bin/oneqrelay run --config /etc/oneq/relay.conf
