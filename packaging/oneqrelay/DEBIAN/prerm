#!/bin/sh
set -e

case "$1" in
remove|upgrade|deconfigure)
    # Stop under whichever manager is running it; both are tried, errors are irrelevant.
    if [ -d /run/systemd/system ]; then
        systemctl stop oneqrelay.service >/dev/null 2>&1 || true
    fi
    if command -v supervisorctl >/dev/null 2>&1; then
        supervisorctl stop oneqrelay >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
