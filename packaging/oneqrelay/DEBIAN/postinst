#!/bin/sh
set -e

# Value of an option from an INI file (first match, any section): conf_get FILE OPTION
conf_get() {
    [ -r "$1" ] || return 0
    awk -F= -v k="$2" '$1 ~ "^[ \t]*" k "[ \t]*$" { gsub(/^[ \t]+|[ \t\r]+$/, "", $2); print $2; exit }' "$1"
}

# Which service manager runs things here: `init =` in /etc/oneq/relay.conf (systemd|supervisor|none) overrides detection.
init_system() {
    forced=$(conf_get /etc/oneq/relay.conf init)
    if [ -n "$forced" ]; then
        echo "$forced"
    elif [ "$(ps -p 1 -o comm= 2>/dev/null)" = systemd ] && [ -d /run/systemd/system ]; then
        echo systemd
    elif command -v supervisorctl >/dev/null 2>&1 && [ -d /etc/supervisor/conf.d ]; then
        echo supervisor
    else
        echo none
    fi
}

case "$1" in
configure)
    if ! getent passwd oneqrelay >/dev/null; then
        adduser --system --group --no-create-home --home /nonexistent \
                --shell /usr/sbin/nologin --quiet oneqrelay
    fi

    install -d -m 0755 -o root -g root /etc/oneq /var/lib/oneq /var/log/oneq
    install -d -m 0700 -o oneqrelay -g oneqrelay /var/lib/oneq/relay

    # Federation secret: generated here for the first relay; every other relay must get a COPY of it.
    if [ ! -f /etc/oneq/relay.secret ]; then
        (umask 077; head -c 32 /dev/urandom | base64 > /etc/oneq/relay.secret)
        chown oneqrelay:oneqrelay /etc/oneq/relay.secret
        chmod 0600 /etc/oneq/relay.secret
        echo "oneqrelay: generated /etc/oneq/relay.secret (copy it to the other relays of the federation)" >&2
    fi

    case "$(init_system)" in
    systemd)
        systemctl daemon-reload || true
        systemctl enable oneqrelay.service >/dev/null 2>&1 || true
        systemctl restart oneqrelay.service || echo "oneqrelay: the service did not start, see: journalctl -u oneqrelay" >&2
        ;;
    supervisor)
        install -m 0644 /opt/oneq/relay/share/supervisor.conf /etc/supervisor/conf.d/oneqrelay.conf
        if supervisorctl reread >/dev/null 2>&1; then
            supervisorctl update >/dev/null 2>&1 || true
            supervisorctl restart oneqrelay >/dev/null 2>&1 || supervisorctl start oneqrelay >/dev/null 2>&1 \
                || echo "oneqrelay: could not start under supervisord, see: supervisorctl status; /var/log/oneq/relay.log" >&2
        else
            echo "oneqrelay: supervisord is not running; start it, then: supervisorctl update" >&2
        fi
        ;;
    *)
        echo "oneqrelay: no service manager detected (systemd or supervisord); start it with /opt/oneq/relay/bin/run" >&2
        ;;
    esac
    ;;
esac

exit 0
