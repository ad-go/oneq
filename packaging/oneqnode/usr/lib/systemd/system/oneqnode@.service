[Unit]
Description=oneqnode %i (layer-2 post-quantum mesh node)
Documentation=file:///usr/share/doc/oneqnode/README.Debian
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/oneq/node.conf

[Service]
Type=simple
User=oneqnode
Group=oneqnode
# The [%i] section of /etc/oneq/node.conf (written by `oneqnode-init %i ...`) holds all the settings; the key and the
# password it points to are plain files owned by the oneqnode user (mode 0600) - no LoadCredential, which does not
# work inside containers, and nothing secret on the command line.
ExecStart=/opt/oneq/node/bin/run %i
Restart=on-failure
RestartSec=3

# CAP_NET_ADMIN only here: create the TAP device and set its MAC, address and MTU
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
