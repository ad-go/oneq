#!/bin/sh
set -e

case "$1" in
remove|deconfigure)
    if [ -d /run/systemd/system ]; then
        systemctl stop 'oneqnode@*.service' >/dev/null 2>&1 || true
    fi
    if command -v supervisorctl >/dev/null 2>&1; then
        for p in $(supervisorctl status 2>/dev/null | awk '/^oneqnode-/ {print $1}'); do
            supervisorctl stop "$p" >/dev/null 2>&1 || true
        done
    fi
    ;;
esac

exit 0
