#!/bin/sh
set -e

drop_supervisor_programs() {
    found=0
    for f in /etc/supervisor/conf.d/oneqnode-*.conf; do
        [ -e "$f" ] || continue
        rm -f "$f"
        found=1
    done
    if [ "$found" = 1 ] && command -v supervisorctl >/dev/null 2>&1; then
        supervisorctl reread >/dev/null 2>&1 || true
        supervisorctl update >/dev/null 2>&1 || true
    fi
}

case "$1" in
remove)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    drop_supervisor_programs
    ;;
purge)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    drop_supervisor_programs
    # Node settings, keys, stored passwords and logs go away only on purge.
    rm -f /etc/oneq/node.conf /etc/oneq/node-*.key /etc/oneq/node-*.key.pub /etc/oneq/node-*.password
    rm -f /var/log/oneq/node-*.log*
    # /etc/oneq and /var/log/oneq are shared with oneqrelay: removed only when nothing else is in them.
    rmdir /etc/oneq /var/log/oneq 2>/dev/null || true
    if getent passwd oneqnode >/dev/null; then
        deluser --system --quiet oneqnode >/dev/null 2>&1 || true
    fi
    if getent group oneqnode >/dev/null; then
        delgroup --system --quiet oneqnode >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
