#!/bin/sh
set -e

case "$1" in
configure)
    if ! getent passwd oneqnode >/dev/null; then
        adduser --system --group --no-create-home --home /nonexistent \
                --shell /usr/sbin/nologin --quiet oneqnode
    fi
    install -d -m 0755 -o root -g root /etc/oneq /var/log/oneq
    # The settings of every node: readable by the service user, writable by root only (written by oneqnode-init).
    chown root:oneqnode /etc/oneq/node.conf
    chmod 0640 /etc/oneq/node.conf

    # Upgrade: restart the nodes that were already running, under whichever manager runs them.
    # Nothing is started on a first install; `oneqnode-init` does that.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        for u in $(systemctl list-units --plain --no-legend --state=active 'oneqnode@*.service' 2>/dev/null | cut -d' ' -f1); do
            systemctl restart "$u" || true
        done
    fi
    if command -v supervisorctl >/dev/null 2>&1; then
        for p in $(supervisorctl status 2>/dev/null | awk '/^oneqnode-/ && /RUNNING/ {print $1}'); do
            supervisorctl restart "$p" >/dev/null 2>&1 || true
        done
    fi
    ;;
esac

exit 0
