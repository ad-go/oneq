; supervisord program for the node @NAME@ ([@NAME@] in /etc/oneq/node.conf), written by `oneqnode-init @NAME@` to
; /etc/supervisor/conf.d/oneqnode-@NAME@.conf. `run` drops privileges to the oneqnode user (CAP_NET_ADMIN only).
[program:oneqnode-@NAME@]
command=/opt/oneq/node/bin/run @NAME@
autostart=true
autorestart=true
startsecs=5
startretries=10
stopsignal=TERM
stopwaitsecs=15
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/oneq/node-@NAME@.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
