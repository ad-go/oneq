#!/bin/bash
# Configure a node and (optionally) start it:   sudo oneqnode-init NAME --relay URL ... --community C --user U
# Remove a node:                                 sudo oneqnode-init NAME --remove
# The settings go to the [NAME] section of /etc/oneq/node.conf; the key and the password to /etc/oneq/node-NAME.*
set -euo pipefail

CONF=/etc/oneq/node.conf

usage() {
    cat >&2 <<'EOF'
usage: oneqnode-init NAME --relay URL [--relay URL ...] --community COMMUNITY --user USER [options]
       oneqnode-init NAME --remove

  NAME                   short name of this node (a-z, 0-9, _ or -, up to 11 characters): section [NAME] in
                         /etc/oneq/node.conf, interface oneq-NAME, systemd service oneqnode@NAME, supervisord program oneqnode-NAME
  --relay URL            oneqrelay address, e.g. https://r1.example.org (repeat for failover)
  --community, --user    account on the oneqrelay; the password is asked for (or --password-file FILE)
  --label TEXT           name shown in the member list (default: host name)
  --listen IP:PORT       UDP address (default 0.0.0.0:51820)
  --advertise IP:PORT    address other nodes can reach this one on (repeat); needed behind NAT or a firewall
  --cafile FILE          CA that signed the oneqrelay certificates, if not in the system store
  --init systemd|supervisor|none
                         service manager (default: `init =` in [defaults] of node.conf, else systemd if it is
                         PID 1, else supervisord if installed, else none)
  --no-start             only write the configuration
  --remove               stop the node and delete its section, key and stored password

The key and the password are files owned by the oneqnode user (mode 0600): /etc/oneq/node-NAME.key, node-NAME.password.
EOF
    exit 2
}
die() { echo "oneqnode-init: $*" >&2; exit 1; }

# `init =` from the [defaults] section of node.conf
conf_init() {
    [ -r "$CONF" ] || return 0
    awk '/^[ \t]*\[/ { in_def = ($0 ~ /^[ \t]*\[defaults\][ \t]*$/); next }
         in_def && /^[ \t]*init[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; exit }' "$CONF"
}
detect_init() {
    local f; f=$(conf_init)
    if [ -n "$f" ]; then echo "$f"
    elif [ "$(ps -p 1 -o comm= 2>/dev/null)" = systemd ] && [ -d /run/systemd/system ]; then echo systemd
    elif command -v supervisorctl >/dev/null 2>&1 && [ -d /etc/supervisor/conf.d ]; then echo supervisor
    else echo none; fi
}

[ $# -ge 1 ] || usage
name=$1; shift
[[ $name =~ ^[a-z0-9_-]{1,11}$ ]] || die "NAME must be 1-11 characters of a-z, 0-9, _ or -"
relays=(); adv=(); community=""; user=""; label=$(hostname -s); listen="0.0.0.0:51820"; pwfile=""; cafile=""
start=1; remove=0; init=""
while [ $# -gt 0 ]; do
    case $1 in
        --relay) [ $# -ge 2 ] || usage; relays+=("$2"); shift 2;;
        --community) [ $# -ge 2 ] || usage; community=$2; shift 2;;
        --user) [ $# -ge 2 ] || usage; user=$2; shift 2;;
        --label) [ $# -ge 2 ] || usage; label=$2; shift 2;;
        --listen) [ $# -ge 2 ] || usage; listen=$2; shift 2;;
        --advertise) [ $# -ge 2 ] || usage; adv+=("$2"); shift 2;;
        --password-file) [ $# -ge 2 ] || usage; pwfile=$2; shift 2;;
        --cafile) [ $# -ge 2 ] || usage; cafile=$2; shift 2;;
        --init) [ $# -ge 2 ] || usage; init=$2; shift 2;;
        --no-start) start=0; shift;;
        --remove) remove=1; shift;;
        *) usage;;
    esac
done
[ "$(id -u)" = 0 ] || die "run as root (sudo oneqnode-init ...)"
[ -n "$init" ] || init=$(detect_init)
[[ $init =~ ^(systemd|supervisor|none)$ ]] || die "init must be systemd, supervisor or none (got '$init')"
key=/etc/oneq/node-$name.key
pwf=/etc/oneq/node-$name.password
sv=/etc/supervisor/conf.d/oneqnode-$name.conf
ONEQNODE=/opt/oneq/node/bin/oneqnode

if [ "$remove" = 1 ]; then
    if [ -d /run/systemd/system ]; then systemctl disable --now "oneqnode@$name.service" >/dev/null 2>&1 || true; fi
    if [ -f "$sv" ]; then
        supervisorctl stop "oneqnode-$name" >/dev/null 2>&1 || true
        rm -f "$sv"
        supervisorctl reread >/dev/null 2>&1 || true
        supervisorctl update >/dev/null 2>&1 || true
    fi
    [ ! -f "$CONF" ] || "$ONEQNODE" config-del --file "$CONF" "$name"
    rm -f "$key" "$key.pub" "$pwf" "/var/log/oneq/node-$name.log"*
    echo "removed node $name"
    exit 0
fi

[ ${#relays[@]} -gt 0 ] && [ -n "$community" ] && [ -n "$user" ] || usage
for v in "$community" "$user" "$label"; do
    [[ $v =~ ^[A-Za-z0-9_.@-]+$ ]] || die "'$v': only letters, digits and . _ @ - are allowed here"
done
for r in "${relays[@]}"; do [[ $r =~ ^https?://[A-Za-z0-9.:_-]+(/)?$ ]] || die "bad relay URL: $r"; done
addr_re='^[][0-9a-fA-F.:]+:[0-9]+$'
for a in ${adv[@]+"${adv[@]}"} "$listen"; do [[ $a =~ $addr_re ]] || die "bad address: $a"; done
[ -z "$cafile" ] || [ -f "$cafile" ] || die "no such file: $cafile"

install -d -m 0755 -o root -g root /etc/oneq /var/log/oneq
umask 077

if [ ! -e "$key" ]; then
    "$ONEQNODE" genkey --key "$key" | sed 's/^/new key, /'
fi
if [ -n "$pwfile" ]; then
    [ -f "$pwfile" ] || die "no such file: $pwfile"
    install -m 0600 -o root -g root "$pwfile" "$pwf"
else
    read -r -s -p "Password of $user@$community: " pw; echo
    [ -n "$pw" ] || die "empty password"
    printf '%s\n' "$pw" > "$pwf"
fi
# the service user reads its own key and password
chown oneqnode:oneqnode "$key" "$pwf"; [ ! -e "$key.pub" ] || chown oneqnode:oneqnode "$key.pub"
chmod 0600 "$key" "$pwf"

if [ ! -e "$CONF" ]; then install -m 0640 -o root -g oneqnode /dev/null "$CONF"; fi
opts=("relays=${relays[*]}" "community=$community" "user=$user" "label=$label" "key_file=$key" "password_file=$pwf"
      "listen=$listen")
[ ${#adv[@]} -eq 0 ] || opts+=("advertise=${adv[*]}")
[ -z "$cafile" ] || opts+=("cafile=$cafile")
"$ONEQNODE" config-set --file "$CONF" "$name" "${opts[@]}"
echo "wrote [$name] in $CONF; key $key; password $pwf"

[ "$start" = 1 ] || exit 0
case $init in
systemd)
    systemctl daemon-reload
    systemctl enable "oneqnode@$name.service" >/dev/null 2>&1 || true
    systemctl restart "oneqnode@$name.service"
    echo "started oneqnode@$name  (logs: journalctl -u oneqnode@$name -f; address: ip addr show oneq-$name)"
    ;;
supervisor)
    sed "s/@NAME@/$name/g" /opt/oneq/node/share/supervisor.conf.in > "$sv"
    chmod 0644 "$sv"
    supervisorctl reread >/dev/null 2>&1 || die "supervisord is not running; start it, then: supervisorctl update"
    supervisorctl update >/dev/null
    supervisorctl restart "oneqnode-$name" >/dev/null 2>&1 || supervisorctl start "oneqnode-$name" >/dev/null 2>&1 || true
    echo "started oneqnode-$name under supervisord  (logs: /var/log/oneq/node-$name.log; address: ip addr show oneq-$name)"
    ;;
none)
    echo "no service manager selected; run it by hand: /opt/oneq/node/bin/run $name" >&2
    ;;
esac
